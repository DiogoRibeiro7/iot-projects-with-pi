device_id = "greenhouse-01"
simulation = false
sample_interval_seconds = 60.0
database = "/var/lib/iot-projects-with-pi/agriculture.db"
events_database = "/var/lib/iot-projects-with-pi/agriculture-events.db"
samples = 1000000
dry_on_percent = 30.0
wet_off_percent = 45.0
max_run_seconds = 300.0
cooldown_seconds = 60.0
relay_pin = 27
adc_channel = 0
dry_raw = 0.8
wet_raw = 0.3
climate = false
dht_pin = "D4"
dht_model = "DHT22"
mqtt_port = 1883
health_file = "/var/lib/iot-projects-with-pi/agriculture-health.json"

