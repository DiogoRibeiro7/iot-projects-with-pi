# Conservative defaults for constrained Raspberry Pi deployments.
WEATHER_DATABASE=/var/lib/iot-projects-with-pi/weather.db
WEATHER_INTERVAL=300
WEATHER_SAMPLES=1000000
DHT_MODEL=DHT22
DHT_PIN=D4

# Home automation should evaluate frequently enough for the target use case,
# but avoid sub-second polling on constrained hardware.
HOME_INTERVAL_SECONDS=10
